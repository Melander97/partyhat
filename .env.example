# Neon Postgres connection string (Neon console > your project > Connect).
DATABASE_URL=

# Signs the game's guess tokens and run receipts. Any long random string works.
# Generate one with: openssl rand -base64 32
# Use a DIFFERENT value for local and for production.
GAME_TOKEN_SECRET=

# Protects the price-refresh cron route. Also any long random string.
CRON_SECRET=

# Optional: Redis for rate limiting (Upstash). Leave empty to run with
# rate limiting off, which is fine locally. On Vercel the Marketplace
# integration sets KV_REST_API_URL and KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
